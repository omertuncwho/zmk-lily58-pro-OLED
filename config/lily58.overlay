/ {
    chosen {
        zmk,display = &oled;
    };
};

&pro_micro_i2c {
    status = "okay";

    /delete-node/ ssd1306@3c;

    oled: sh1106@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        /* 
         * Bu satır, SH1106 bellek adresleme sorunlarını çözmek için
         * toplulukta kullanılan bir yöntemdir. Ekran fiziksel olarak 64px
         * olsa da, sürücüyü 128px olarak ayarlamak adreslemeyi düzeltebilir.
         */
        height = <128>; 
        segment-offset = <2>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        com-invdir;
        segment-remap;
        prechargep = <0x22>;
        label = "DISPLAY";
    };
};
