/ {
    chosen {
        zephyr,display = &oled;
    };
};

&pro_micro_i2c {
    status = "okay";

    oled: ssd1306@3c {
        compatible = "sinowealth,sh1106"; // SH1106 sürücüsü
        reg = <0x3c>;
        width = <128>;
        height = <64>; // 128x64 çözünürlük
        segment-offset = <2>; // Karıncalanmayı önleyen ofset
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        segment-remap;
        com-invdir;
        prechargep = <0x22>;
    };
};
