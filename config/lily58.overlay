/ {
    chosen {
        zmk,display = &oled;
    };
};

&pro_micro_i2c {
    status = "okay";

    oled: sh1106@3c {
        compatible = "sinowealth,sh1106"; // Sürücüyü SSD1306'dan SH1106'ya çektik
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <2>; // Karıncalanmayı bitiren ve ikonları ortalayan en kritik değer
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        segment-remap;
        com-invdir;
        prechargep = <0x22>;
    };
};
