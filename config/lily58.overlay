/ {
    chosen {
        zmk,display = &oled;
    };
};

&pro_micro_i2c {
    status = "okay";

    /* Önce varsayılan Lily58 OLED düğümünü siliyoruz */
    /delete-node/ ssd1306@3c;

    /* Şimdi kendi SH1106 ekranımızı aynı adrese tanımlıyoruz */
    oled: sh1106@3c {
        compatible = "sinowealth,sh1106";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <2>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        segment-remap;
        com-invdir;
        prechargep = <0x22>;
    };
};
