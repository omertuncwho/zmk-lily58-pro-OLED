/ {
    chosen {
        zmk,display = &oled;
    };
};

&pro_micro_i2c {
    status = "okay";

    /* Eski ssd1306 tanımını tamamen temizliyoruz */
    /delete-node/ ssd1306@3c;

    oled: sh1106@3c {
        /* KRİTİK: compatible değerini SH1106 yapmalıyız */
        compatible = "sinowealth,sh1106";
        reg = <0x3c>;
        width = <128>;
        height = <64>;  /* 128px denemesini iptal edip gerçek değerini yazıyoruz */
        segment-offset = <2>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        segment-remap;
        com-invdir;
        prechargep = <0x22>;
        label = "DISPLAY";
    };
};
